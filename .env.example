# Server Config
PORT=5000

# Database Configuration
# Leave MONGODB_URI empty to run the app with local JSON file-based database fallback automatically
MONGODB_URI=mongodb://localhost:27017/architect_ai

# Google Gemini API Key
# Get a key from Google AI Studio: https://aistudio.google.com/
# Leave as 'mock' to run the requirements extractor in simulated/mock mode without an API key
GEMINI_API_KEY=YOUR_API_KEY_HERE
